PORT=3500

# Base de datos (Supabase Postgres)
DB_HOST=your-supabase-db-host.supabase.co
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-super-secure-password
DB_NAME=postgres
# false para Postgres propio (docker compose); omitir o true para Supabase
# DB_SSL=false

# Orígenes permitidos (CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://arm-solutions.com.mx,https://eventos-mendoza.arm-solutions.com.mx

# Negocio de esta instancia (una instancia = un negocio). Si se omite, se usa el
# negocio activo más antiguo. Crear uno: node dist/src/scripts/user-admin.js create-business "<nombre>" <slug>
BUSINESS_SLUG=mi-negocio

# Autenticación propia (Fase 3)
# Secreto para firmar las sesiones (JWT). Genera uno largo y aleatorio:
#   openssl rand -hex 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
# Cookie de sesión: dominio compartido entre front y API (p. ej. .dejuarez.mx).
# Vacío en local (localhost). COOKIE_SECURE=false solo en local sin HTTPS.
# COOKIE_DOMAIN=.dejuarez.mx
# COOKIE_SECURE=false

# Archivos subidos (logos, galería). En Docker, STORAGE_DIR ya lo fija compose.
STORAGE_DIR=./storage
# URL pública base de los archivos (el API los sirve en /files). Producción: https://api.tudominio.mx/files
STORAGE_PUBLIC_URL=http://localhost:3500/files

DOCS_USER=tu_usuario_seguro
DOCS_PASSWORD=tu_contraseña_secreta

# ── Downloader Module (yt-dlp + ffmpeg) ──────────────────────────────────────
# Ruta al binario yt-dlp. Si está en el PATH del sistema, deja el valor por defecto.
YTDLP_BIN=yt-dlp
# Ruta al binario ffmpeg. Si está en el PATH del sistema, deja el valor por defecto.
FFMPEG_BIN=ffmpeg
# Duración máxima de descarga en segundos (default 3600 = 1 hora).
DOWNLOADER_MAX_DURATION_SEC=3600
