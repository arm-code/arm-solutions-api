PORT=3500

# Base de datos (Supabase Postgres)
DB_HOST=your-supabase-db-host.supabase.co
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your-super-secure-password
DB_NAME=postgres

# Orígenes permitidos (CORS)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://arm-solutions.com.mx,https://eventos-mendoza.arm-solutions.com.mx

# Supabase Auth
# Project Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# Project Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key

DOCS_USER=tu_usuario_seguro
DOCS_PASSWORD=tu_contraseña_secreta

# ── Downloader Module (yt-dlp + ffmpeg) ──────────────────────────────────────
# Ruta al binario yt-dlp. Si está en el PATH del sistema, deja el valor por defecto.
YTDLP_BIN=yt-dlp
# Ruta al binario ffmpeg. Si está en el PATH del sistema, deja el valor por defecto.
FFMPEG_BIN=ffmpeg
# Duración máxima de descarga en segundos (default 3600 = 1 hora).
DOWNLOADER_MAX_DURATION_SEC=3600
